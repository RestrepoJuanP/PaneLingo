# Copia este archivo a .env y completa los valores.
# .env NUNCA se versiona: contiene secretos reales.

# Clave criptográfica de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Modo depuración. "True" solo en desarrollo local, nunca en producción.
DJANGO_DEBUG=True

# Hosts autorizados, separados por comas. Ejemplo: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
