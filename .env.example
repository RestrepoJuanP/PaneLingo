# Copia este archivo a .env y completa los valores.
# .env NUNCA se versiona: contiene secretos reales.

# Clave criptográfica de Django. Genera una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Modo depuración. "True" solo en desarrollo local, nunca en producción.
DJANGO_DEBUG=True

# Hosts autorizados, separados por comas. Ejemplo: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Tareas en segundo plano (Huey). Con False hay que arrancar el trabajador en
# otra terminal: python manage.py run_huey
# Con True cada tarea corre dentro de la petición, sin trabajador.
HUEY_IMMEDIATE=False

# Detección de texto de las páginas (HU-12).
# "fake" usa un proveedor simulado, sin red ni claves.
# "azure" usa Azure AI Vision Read: crea un recurso Computer Vision con el plan
# F0 (gratuito) y copia aquí su punto de conexión y su clave.
OCR_PROVIDER=fake
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
