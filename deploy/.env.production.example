# Variables del despliegue en producción. Copia este archivo a .env en la
# raíz del proyecto, en el servidor, y completa los valores. Nunca lo subas
# a Git.

# Dominio público. Sin dominio propio sirve <ip-con-guiones>.sslip.io, que
# resuelve a la IP elástica de la instancia (por ejemplo 18-1-2-3.sslip.io).
SITE_ADDRESS=

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_PROXY=True

HUEY_IMMEDIATE=False

OCR_PROVIDER=azure
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
