# Python
__pycache__/
*.py[cod]

# Entornos virtuales
.venv/
venv/
env/

# Django
db.sqlite3
# Se ignora el CONTENIDO de media/, no el directorio: Git no desciende en un
# directorio excluido, asi que la negacion del marcador no funcionaria.
media/*
!media/.gitkeep

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Cobertura y cachés de herramientas
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/

# Editores
.vscode/
.idea/
